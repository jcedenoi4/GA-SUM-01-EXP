  <diagram id="spotify-april-2025" name="Causas raíz">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="430" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="stage" value="Cadena causal" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;fontFamily=Arial;fontStyle=1;fontSize=24;fontColor=#1D446F;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1160" height="35" as="geometry"/></mxCell>
        <mxCell id="rollout" value="&lt;b&gt;Desencadenante&lt;/b&gt;&lt;br&gt;Cambio en el orden de&lt;br&gt;los filtros de Envoy en&lt;br&gt;todas las regiones." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=9;strokeWidth=1.5;fontFamily=Arial;fontSize=22;fontColor=#172A40;fillColor=#EDF4FD;strokeColor=#779BBC;" vertex="1" parent="1"><mxGeometry x="0" y="46" width="255" height="154" as="geometry"/></mxCell>
        <mxCell id="bug" value="&lt;b&gt;Fallo del filtro&lt;/b&gt;&lt;br&gt;El cambio activó un&lt;br&gt;defecto. Las instancias&lt;br&gt;de Envoy fallaron." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=9;strokeWidth=1.5;fontFamily=Arial;fontSize=22;fontColor=#172A40;fillColor=#FFF2E5;strokeColor=#C68E50;" vertex="1" parent="1"><mxGeometry x="302" y="46" width="255" height="154" as="geometry"/></mxCell>
        <mxCell id="load" value="&lt;b&gt;Pico de carga&lt;/b&gt;&lt;br&gt;Reinicios simultáneos&lt;br&gt;y reintentos de clientes&lt;br&gt;saturaron el perímetro." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=9;strokeWidth=1.5;fontFamily=Arial;fontSize=22;fontColor=#172A40;fillColor=#FFF2E5;strokeColor=#C68E50;" vertex="1" parent="1"><mxGeometry x="604" y="46" width="255" height="154" as="geometry"/></mxCell>
        <mxCell id="memory" value="&lt;b&gt;Ciclo de reinicios&lt;/b&gt;&lt;br&gt;Envoy rebasaba&lt;br&gt;el límite de memoria.&lt;br&gt;Kubernetes detenía&lt;br&gt;cada nueva instancia." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=9;strokeWidth=1.5;fontFamily=Arial;fontSize=22;fontColor=#172A40;fillColor=#FCEBED;strokeColor=#C68189;" vertex="1" parent="1"><mxGeometry x="906" y="46" width="255" height="154" as="geometry"/></mxCell>
        <mxCell id="arrow1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#52657B;strokeWidth=2;" edge="1" parent="1" source="rollout" target="bug"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arrow2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#52657B;strokeWidth=2;" edge="1" parent="1" source="bug" target="load"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arrow3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#52657B;strokeWidth=2;" edge="1" parent="1" source="load" target="memory"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="response" value="Recuperación y prevención" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;fontFamily=Arial;fontStyle=1;fontSize=24;fontColor=#17645D;" vertex="1" parent="1"><mxGeometry x="0" y="217" width="1160" height="35" as="geometry"/></mxCell>
        <mxCell id="mitigate" value="&lt;b&gt;Mitigación durante la caída&lt;/b&gt;&lt;br&gt;Spotify amplió la capacidad del perímetro.&lt;br&gt;Bajó la carga por instancia y cesaron los reinicios." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=9;strokeWidth=1.5;fontFamily=Arial;fontSize=22;fontColor=#172A40;fillColor=#EAF8F3;strokeColor=#65A298;" vertex="1" parent="1"><mxGeometry x="0" y="263" width="544" height="111" as="geometry"/></mxCell>
        <mxCell id="prevent" value="&lt;b&gt;Medidas posteriores&lt;/b&gt;&lt;br&gt;Corrigió el filtro y ajustó los límites de memoria.&lt;br&gt;Anunció mejoras de despliegue y monitoreo." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=9;strokeWidth=1.5;fontFamily=Arial;fontSize=22;fontColor=#172A40;fillColor=#EAF8F3;strokeColor=#65A298;" vertex="1" parent="1"><mxGeometry x="616" y="263" width="545" height="111" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
